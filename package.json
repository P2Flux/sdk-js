{
  "name": "@p2flux/sdk",
  "version": "0.10.0",
  "description": "JavaScript/TypeScript client for the P2Flux payments API.",
  "license": "MIT",
  "homepage": "https://p2flux.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P2Flux/sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/P2Flux/sdk-js/issues"
  },
  "keywords": [
    "payments",
    "usdc",
    "stablecoin",
    "base",
    "subscriptions",
    "recurring",
    "checkout",
    "erc20",
    "web3",
    "x402",
    "ai-agents",
    "paywall"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paywall": {
      "types": "./dist/paywall.d.ts",
      "default": "./dist/paywall.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
